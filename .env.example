# ==============================================================================
# ocmail — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL / Supabase / Neon / Vercel Postgres)
# ------------------------------------------------------------------------------
# Untuk Supabase:
# - DATABASE_URL gunakan port 6543 (Transaction Pooler) dengan param ?pgbouncer=true
# - DIRECT_URL   gunakan port 5432 (Direct Connection) untuk prisma db push / migrate
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH / AUTH.JS v5
# ------------------------------------------------------------------------------
# Buat secret 32-karakter acak dengan command: openssl rand -base64 32
AUTH_SECRET="your-secure-random-auth-secret-here"
# Di localhost gunakan http://localhost:3000, di Vercel gunakan URL domain production Anda
AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. OAUTH PROVIDERS (Google & GitHub)
# ------------------------------------------------------------------------------
# Google Cloud Console: Redirect URI -> {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub Developer Settings: Callback URL -> {AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ------------------------------------------------------------------------------
# 4. ADMIN PRIVILEGES
# ------------------------------------------------------------------------------
# Email akun yang otomatis mendapatkan role ADMIN saat login (pisahkan dengan koma jika lebih dari satu)
ADMIN_EMAILS="admin@example.com"

# ------------------------------------------------------------------------------
# 5. CLOUDFLARE WORKER BRIDGE (Catch-all + KV Store)
# ------------------------------------------------------------------------------
# URL deployment Cloudflare Worker (cloudflare/worker.js)
CF_WORKER_URL="https://ocmail-worker.[SUBDOMAIN].workers.dev"

# Secret token autentikasi antara Cloudflare Worker & Webhook Next.js
WORKER_WEBHOOK_SECRET="generate-secret-acak-hex-disini"

# ------------------------------------------------------------------------------
# 6. TEMPMAIL DOMAINS
# ------------------------------------------------------------------------------
# Daftar domain aktif yang diarahkan di Cloudflare Email Routing (pisahkan dengan koma)
ALLOWED_DOMAINS="example.biz.id,example.my.id"

# ------------------------------------------------------------------------------
# 7. UPSTASH REDIS (Rate Limiting + Webhook Replay Protection)
# ------------------------------------------------------------------------------
# Buat database di https://upstash.com → Redis → Create Database (Free tier cukup)
# Copy REST URL dan REST Token dari dashboard
UPSTASH_REDIS_REST_URL="https://[REGION]-[ID].upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token-here"

# ------------------------------------------------------------------------------
# 8. CRON JOB SECRET (Daily Cleanup)
# ------------------------------------------------------------------------------
# Secret untuk autentikasi Vercel Cron Job yang cleanup expired inboxes
# Generate dengan: openssl rand -hex 32
CRON_SECRET="generate-secret-acak-hex-disini"
